<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Groceries.ShoppingListPage"
             x:Name="ShoppingListPageRef"
             Title="Boodschappenlijstje">
    <ScrollView>
        <VerticalStackLayout>
            <Image
                Source="shopping_basket.jpg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />
            <CollectionView ItemsSource="{Binding list}"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="1" x:Name="ItemContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.1*"/>
                            </Grid.ColumnDefinitions>
                            <Label Text="•" FontSize="20" VerticalTextAlignment="Center" Grid.Column="0" HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding Name}" FontSize="20" Grid.Column="1" Margin="8,0,0,0" VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsPickedUp}" Value="True">
                                        <Setter Property="TextColor" Value="Gray"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding DisplayAmount}"
                                   FontSize="20" Grid.Column="2" 
                                   Margin="8,0,0,0" VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsPickedUp}" Value="True">
                                        <Setter Property="TextColor" Value="Gray"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Grid.Behaviors>
                                <toolkit:TouchBehavior
                                        LongPressCommand="{Binding Source={x:Reference ShoppingListPageRef}, Path=BindingContext.OnItemLongPressed}"
                                        LongPressCommandParameter="{Binding BindingContext, Source={x:Reference ItemContainer}}"
                                        LongPressDuration="500"/>
                            </Grid.Behaviors>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <Button Text="Reset"
                        FontSize="18"
                        Clicked="OnResetClicked"
                        HorizontalOptions="Fill"
                        Margin="10,20,10,10"
                        Grid.Column="0"/>
                <Button Text="Catalogus"
                        FontSize="18"
                        Clicked="OnCatalogusClicked"
                        HorizontalOptions="Fill"
                        Margin="0,20,10,10"
                        Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>