<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Groceries.EditItemPopup"
               CanBeDismissedByTappingOutsideOfPopup="True"
               BackgroundColor="#80000000">
    <Frame BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}"
           CornerRadius="12"
           Padding="20"
           HasShadow="True"
           WidthRequest="300">
    <VerticalStackLayout Padding="20" WidthRequest="300" >
            <Label Text="Edit Product"
               FontAttributes="Bold"
               FontSize="18"
               HorizontalOptions="Center"/>
            <Entry x:Name="NameEntry" Placeholder="Name"
                   TextColor="{AppThemeBinding Light='Black', Dark='White'}"
                   PlaceholderColor="{AppThemeBinding Light='#888', Dark='#AAA'}"/>
            <Entry x:Name="PriorityEntry" Placeholder="Priority" Keyboard="Numeric"
                   TextColor="{AppThemeBinding Light='Black', Dark='White'}"
                   PlaceholderColor="{AppThemeBinding Light='#888', Dark='#AAA'}"/>
            <Button Text="Save" Clicked="OnSaveClicked"
                   BackgroundColor="{AppThemeBinding Light='#0078D7', Dark='#3399FF'}"
                   TextColor="White"/>
    </VerticalStackLayout>
    </Frame>
</toolkit:Popup>